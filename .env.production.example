# MeetCopilot v2 — PRODUCTION environment template.
# Copy to .env.production on the VM, fill every REQUIRED value, keep it OUT of git.
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# This one file is consumed two ways (see docker-compose.yml):
#   • `docker compose --env-file .env.production ...` → ${VAR} interpolation
#     (build args + DOMAIN/ACME_EMAIL). NEXT_PUBLIC_API_BASE is baked into the web
#     image at BUILD time — rebuild web whenever the domain changes.
#   • per-service `env_file:` → server container runtime environment.
# NOTE: env_file does NOT expand ${VAR}. Write full literal values (no interpolation).

# ── Site / TLS (caddy + web build) ───────────────────────────────────────────
DOMAIN=meetcopilot.example.com                     # REQUIRED. Your real domain (A record → VM IP).
ACME_EMAIL=ops@example.com                          # Let's Encrypt account email (renewal notices).
NEXT_PUBLIC_API_BASE=https://meetcopilot.example.com # REQUIRED. Public REST+WS base (baked into web build).

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8787                                            # internal; caddy proxies to it
DB_PATH=/data/meetcopilot.db                         # MUST be under the persistent /data volume
WEB_ORIGIN=https://meetcopilot.example.com           # REQUIRED. Server CORS allow-origin (the web URL)

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Long random secret — server refuses to start on empty/placeholder.
# Generate:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# ── LLM (text / analysis / generation / embedding / live) — Gemini @google/genai ─
GEMINI_API_KEY=                                      # REQUIRED. Google AI Studio key.
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite              # text + analysis + slide generation
GEMINI_EXTRACT_MODEL=gemini-3.5-flash                # crawl→CRM structured extraction (see LESSONS L15)
GEMINI_EMBED_MODEL=gemini-embedding-001              # embeddings (JS cosine retrieval)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview      # voice training (browser direct via ephemeral token)

# ── AI image generation (pre-meeting only) — OpenAI gpt-image-2 ───────────────
OPENAI_API_KEY=                                      # REQUIRED for image gen. Org must be verified.
OPENAI_IMAGE_MODEL=gpt-image-2                        # background + full-slide image model
OPENAI_IMAGE_SIZE=1536x864                            # native 16:9
OPENAI_IMAGE_QUALITY=medium                           # low | medium | high

# ── Research / crawl limits ──────────────────────────────────────────────────
RESEARCH_AUTO_LIMIT_PER_MEETING=10                   # max auto-triggered crawl/ground jobs per meeting

# ── Privacy / retention (M5 §A) ──────────────────────────────────────────────
# Default retention (days) for PERSISTED transcripts; the TTL purge job deletes
# persisted transcript segments older than this. Only applies when a meeting opts
# into persist_transcript=1 (default is memory-only, nothing written). Consumed by
# the privacy TTL job (migration 009 meetings.retention_days column default = 30).
RETENTION_DAYS=30

# ── Backups (scripts/backup.sh cron) ─────────────────────────────────────────
BACKUP_RETENTION_DAYS=14                              # prune *.db.gz snapshots older than N days
