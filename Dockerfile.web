# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# MeetCopilot v2 — web (Next.js 15 App Router, next-intl) as a standalone server.
#
# next.config.mjs sets `output: "standalone"` + `outputFileTracingRoot = <repo root>`,
# so the build emits a self-contained tree under .next/standalone with the entry at
# apps/web/server.js and hoisted node_modules alongside. Runtime image is slim.
#
# IMPORTANT: NEXT_PUBLIC_API_BASE is inlined into the client bundle AND the CSP
# header at BUILD time — it is a build ARG, not a runtime env. Changing the domain
# requires rebuilding this image (see docs/DEPLOY.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── build stage ──────────────────────────────────────────────────────────────
FROM node:22-bookworm AS builder
WORKDIR /app

# Manifests first for layer caching. All workspaces' package.json are required so
# `npm ci` reconstructs the tree matching package-lock.json.
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/crm/package.json ./packages/crm/
COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json ./apps/web/
RUN npm ci

# Sources needed to build web (+ shared, which web transpiles from source).
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# Public API base is baked into the bundle + CSP at build time.
ARG NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE} \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build --workspace @meetcopilot/web

# ── runtime stage ────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

# Standalone bundle (includes apps/web/server.js + hoisted node_modules), plus the
# static assets and public/ which standalone intentionally does NOT copy.
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000
CMD ["node", "apps/web/server.js"]
