# MeetCopilot v2 — environment template (copy to apps/server/.env; NEXT_PUBLIC_* also read by apps/web)
# Keys per docs/ARCHITECTURE_PLAN.md §1. Server fails fast when a required key is missing.

# ── LLM (text / analysis / generation / embedding / live) — Gemini @google/genai ──
GEMINI_API_KEY=                                   # REQUIRED. Google AI Studio key.
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite           # text + analysis + slide generation (JSON mode)
GEMINI_EXTRACT_MODEL=gemini-3.5-flash             # crawl→CRM structured extraction (flash-lite unstable here, see LESSONS L15)
GEMINI_EMBED_MODEL=gemini-embedding-001           # embeddings (JS cosine retrieval)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview   # voice training (browser direct via ephemeral token)

# ── Auth ──
JWT_SECRET=                                        # REQUIRED. Fail-fast if empty. Use a long random string.

# ── Google Sign-In (optional) — same Google identity as EZpage; reuse EZpage's OAuth client id ──
# When GOOGLE_CLIENT_ID is set, the server enables POST /api/auth/google (verifies the Google ID token and
# find-or-creates a local user+org by the verified email). Unset → Google login off; local email/password only.
# EZpage's client id: 54139295474-f7cve65n4884ttkcbc2o23hs763q7hm4.apps.googleusercontent.com
GOOGLE_CLIENT_ID=                                  # server: Google OAuth client id used as the ID-token audience
NEXT_PUBLIC_GOOGLE_CLIENT_ID=                      # web (build-time): the SAME client id; renders the GIS "使用 Google 登入" button

# ── Platform admin (apps/admin console — server-side gate & CORS) ──
# Comma-separated email allowlist. A login whose email is in this list gets platformAdmin=true in its
# JWT and may pass /api/admin/*. Empty → no platform admins (admin console unusable). See ADMIN_CONTRACT §1.
PLATFORM_ADMIN_EMAILS=                             # e.g. ops@example.com,admin@example.com
# CORS allow-origin for the admin app, added to the WEB_ORIGIN allowlist (ADMIN_CONTRACT §6.1).
# Dev default already covers http://localhost:3100; only set when admin runs on another origin.
ADMIN_ORIGIN=http://localhost:3100                # admin dev port is 3100 (avoids web's 3000)

# ── Server ──
PORT=8787                                          # Express + ws listen port
DB_PATH=./data/meetcopilot.db                      # better-sqlite3 file path

# ── AI image generation (pre-meeting only) — OpenAI gpt-image-2 ──
OPENAI_API_KEY=                                     # REQUIRED for image generation. Org must be verified.
OPENAI_IMAGE_MODEL=gpt-image-2                      # background + full-slide image model
OPENAI_IMAGE_SIZE=1536x864                          # native 16:9
OPENAI_IMAGE_QUALITY=medium                         # low | medium | high

# ── Research / crawl limits（RESEARCH_UPGRADE_CONTRACT WP3「深與廣，30–60 分鐘級」：多數上限大幅放寬）──
RESEARCH_AUTO_LIMIT_PER_MEETING=10                 # max auto-triggered crawl/ground jobs per meeting
RESEARCH_JOB_TIMEOUT_MS=5400000                    # 整體 job 逾時（預設 90 分；防背景流程掛死；寬鬆於 grounding 60 分＋序列後處理）
CRAWL_NAV_TIMEOUT_MS=45000                         # per-page page.goto budget; clamp 5000–120000, bounded by overall crawl deadline
CRAWL_DEADLINE_QUICK_MS=120000                     # quick 單頁整場上限（clamp 15000–1800000）
CRAWL_DEADLINE_DETAILED_MS=1800000                 # detailed 整場上限（clamp 30000–1800000；硬上限 30 分鐘）
MAX_CRAWL_PAGES=150                                # detailed BFS 總頁數上限（含首頁）；clamp 2–300，仍受 30 分鐘 deadline 硬止血
MAX_CRAWL_DEPTH=3                                  # detailed BFS 追連結層數（分類→列表→明細）；clamp 1–6，仍受整場 deadline 硬止血
CRAWL_CONCURRENCY=5                                # detailed 平行抓取的 worker 數；clamp 1–8
DEEP_RESEARCH_BUDGET_MS=3600000                    # 全網深度研究整場軟 deadline（預設 60 分；clamp 30000–3600000）
DEEP_RESEARCH_ROUNDS=3                             # 多輪研究輪數（clamp 1–5）；一輪無新事實即提早停
DEEP_RESEARCH_MAX_QUERIES=22                       # grounding 扇出上限/輪（S1：11 角度×雙語=22；clamp 3–24）
DEEP_RESEARCH_MAX_SOURCES=12                       # 深讀來源上限/輪（S1-A4：6→12；clamp 0–20；含 JS 渲染 fallback）
DEEP_RESEARCH_GROUNDING_CONCURRENCY=2              # grounding 扇出並行度（clamp 1–6）；升模 gemini-3.5-flash 後過高並行易互相拖慢→504 DEADLINE_EXCEEDED，故預設調降為 2
SOCIAL_FETCH_BUDGET_MS=600000                      # 社群 fetch（youtube+threads）總預算（預設 10 分；clamp 30000–1800000）

# ── Research / social sources（WP1）──
# YouTube Data API v3 key（官方讀取；免費 10k units/日）。缺 → YouTube 平台優雅 skip（一次性 warning，非 job 失敗）；
# Threads（無登入 Playwright）＋ FB/IG（Gemini grounding）不受影響。只進 env，絕不落碼/落庫/落 log。
YOUTUBE_API_KEY=                                   # optional; empty → skip YouTube platform

# ── Cost / pricing overrides (optional; ADMIN_CONTRACT §3.4) ──
# est_cost_usd 由 ops/pricing.ts 的中央估算常數算出（非權威帳單）。上線前以 provider 官方定價校正時，用
# 環境變數就地覆寫某個 model 的單價（boot 時 loadPricingOverrides 套用，只影響覆寫後寫入的 usage_events）。
# 格式：PRICING__<MODEL 大寫底線>__INPUT_PER_M / __OUTPUT_PER_M（token 類，USD/1M tokens）、__PER_IMAGE（生圖，USD/張）。
# MODEL 轉換：非英數字元→底線，例：gemini-3.5-flash → GEMINI_3_5_FLASH、gpt-image-2 → GPT_IMAGE_2。
# 未設任何一項 → 完全沿用 pricing.ts 內建估算值（行為不變）。範例（取消註解以啟用）：
# PRICING__GEMINI_3_1_FLASH_LITE__INPUT_PER_M=0.10        # 文字/分析/生成 (flash-lite) 每 1M input token
# PRICING__GEMINI_3_1_FLASH_LITE__OUTPUT_PER_M=0.40
# PRICING__GEMINI_3_5_FLASH__INPUT_PER_M=0.30             # 抽取/會中分析 (flash) 每 1M input token
# PRICING__GEMINI_3_5_FLASH__OUTPUT_PER_M=2.50
# PRICING__GEMINI_EMBEDDING_001__INPUT_PER_M=0.15         # embedding（無 output 計費）
# PRICING__GEMINI_3_1_FLASH_LIVE_PREVIEW__INPUT_PER_M=0.50  # 語音模擬 Live
# PRICING__GEMINI_3_1_FLASH_LIVE_PREVIEW__OUTPUT_PER_M=2.00
# PRICING__GPT_IMAGE_2__PER_IMAGE=0.04                    # 生圖每張

# ── Web (Next.js) — public, must go through env, never hardcode localhost ──
NEXT_PUBLIC_API_BASE=http://localhost:8787         # REST + WS base URL (the "cloud path")
