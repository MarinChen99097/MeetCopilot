# MeetCopilot v2 — environment template (copy to apps/server/.env; NEXT_PUBLIC_* also read by apps/web)
# Keys per docs/ARCHITECTURE_PLAN.md §1. Server fails fast when a required key is missing.

# ── LLM (text / analysis / generation / embedding / live) — Gemini @google/genai ──
GEMINI_API_KEY=                                   # REQUIRED. Google AI Studio key.
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite           # text + analysis + slide generation (JSON mode)
GEMINI_EMBED_MODEL=gemini-embedding-001           # embeddings (JS cosine retrieval)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview   # voice training (browser direct via ephemeral token)

# ── Auth ──
JWT_SECRET=                                        # REQUIRED. Fail-fast if empty. Use a long random string.

# ── Server ──
PORT=8787                                          # Express + ws listen port
DB_PATH=./data/meetcopilot.db                      # better-sqlite3 file path

# ── AI image generation (pre-meeting only) — OpenAI gpt-image-2 ──
OPENAI_API_KEY=                                     # REQUIRED for image generation. Org must be verified.
OPENAI_IMAGE_MODEL=gpt-image-2                      # background + full-slide image model
OPENAI_IMAGE_SIZE=1536x864                          # native 16:9
OPENAI_IMAGE_QUALITY=medium                         # low | medium | high

# ── Research / crawl limits ──
RESEARCH_AUTO_LIMIT_PER_MEETING=10                 # max auto-triggered crawl/ground jobs per meeting

# ── Web (Next.js) — public, must go through env, never hardcode localhost ──
NEXT_PUBLIC_API_BASE=http://localhost:8787         # REST + WS base URL (the "cloud path")
