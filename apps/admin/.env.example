# apps/admin — 平台管理後台前端環境變數（build-time bake，同 apps/web 慣例）

# 後端 REST API base（不含結尾斜線）。dev 預設 http://localhost:8787。
# 部署時 baked 進 build（cloudbuild-admin.yaml substitution _API_BASE）。
NEXT_PUBLIC_API_BASE=http://localhost:8787

# （選用）Google 登入用的 public client id。未設時 /login 只顯示 Email+密碼表單。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
