# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# MeetCopilot v2 — admin (Next.js 15 App Router, zh-TW single-locale) as a
# standalone server. Platform-operator console (apps/admin), the 3rd Cloud Run
# service. Structurally identical to Dockerfile.web; only the target workspace
# (apps/web → apps/admin) and the default PORT (3000 → 3100, per ADMIN_CONTRACT
# §6.2 admin dev port) differ.
#
# next.config.mjs sets `output: "standalone"` + `outputFileTracingRoot = <repo root>`,
# so the build emits a self-contained tree under .next/standalone with the entry at
# apps/admin/server.js and hoisted node_modules alongside. Runtime image is slim.
#
# IMPORTANT: NEXT_PUBLIC_API_BASE is inlined into the client bundle AND the CSP
# header at BUILD time — it is a build ARG, not a runtime env. Changing the domain
# requires rebuilding this image (see docs/DEPLOY.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── build stage ──────────────────────────────────────────────────────────────
FROM node:22-bookworm AS builder
WORKDIR /app

# Manifests first for layer caching. All workspaces' package.json are required so
# `npm ci` reconstructs the tree matching package-lock.json.
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/crm/package.json ./packages/crm/
COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json ./apps/web/
COPY apps/admin/package.json ./apps/admin/
RUN npm ci

# Sources needed to build admin. packages/shared is copied for parity with web and to
# future-proof admin consuming @meetcopilot/shared domain types (it currently does not);
# harmless if unused. tsconfig.base.json kept for the same reason.
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/admin ./apps/admin

# Public API base is baked into the bundle + CSP at build time.
ARG NEXT_PUBLIC_API_BASE
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE} \
    NEXT_PUBLIC_GOOGLE_CLIENT_ID=${NEXT_PUBLIC_GOOGLE_CLIENT_ID} \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build --workspace @meetcopilot/admin

# ── runtime stage ────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3100 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

# Standalone bundle (includes apps/admin/server.js + hoisted node_modules) plus the
# static assets, which standalone intentionally does NOT copy.
# NOTE: unlike apps/web, apps/admin ships no public/ dir (UI is pure CSS + inline SVG,
# ADMIN_CONTRACT §5), so there is no `COPY apps/admin/public` step. Add one here if a
# public/ dir is later introduced (a COPY of a missing path fails the build).
COPY --from=builder /app/apps/admin/.next/standalone ./
COPY --from=builder /app/apps/admin/.next/static ./apps/admin/.next/static

EXPOSE 3100
CMD ["node", "apps/admin/server.js"]
